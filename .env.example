# Radarr
RADARR_API_KEY=your_radarr_api_key
RADARR_URL=https://radarr.example.com
# Or use host:port instead of URL:
# RADARR_PORT=7878

# Sonarr (TV series)
SONARR_API_KEY=your_sonarr_api_key
SONARR_URL=https://sonarr.example.com
# Or use host:port instead of URL:
# SONARR_PORT=8989

# Sonarr Anime (optional second instance)
SONARR_ANIME_API_KEY=your_sonarr_anime_api_key
SONARR_ANIME_URL=https://sonarr-anime.example.com
# Or use host:port instead of URL:
# SONARR_ANIME_PORT=8990

# NAS IP (only needed if not using URL fields above)
# NAS_IP=10.0.0.23

# MCP Server
MCP_SERVER_PORT=3000
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0

# Jellyfin (optional)
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Plex (optional)
PLEX_BASE_URL=
PLEX_TOKEN=
